{
  "name": "watchtower",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Windows desktop app that keeps marked taskbar apps out of screenshots",
  "author": "Watchtower",
  "license": "MIT",
  "homepage": "https://github.com/abhinavsilwal247/watchtowerfull_new_hiding",
  "repository": {
    "type": "git",
    "url": "https://github.com/abhinavsilwal247/watchtowerfull_new_hiding.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"node server/index.js\" \"vite\"",
    "dev:mock": "concurrently -k \"node server/index.js --mock\" \"vite\"",
    "build": "vite build",
    "test": "node --test test/policy.test.js",
    "start": "npm run build && node server/index.js",
    "app": "vite build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:publish": "npm run build && electron-builder --win --publish always",
    "ship": "npm version patch && git push origin main --follow-tags"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^35.1.2",
    "electron-builder": "^25.1.8",
    "vite": "^6.4.5"
  },
  "build": {
    "appId": "com.watchtower.hiding",
    "productName": "Watchtower",
    "copyright": "Copyright © Watchtower",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*",
          "!data/*.json",
          "!data/*.tmp",
          "!data/*.mock.json"
        ]
      },
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "build",
        "to": "build",
        "filter": [
          "icon.png"
        ]
      }
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "abhinavsilwal247",
        "repo": "watchtowerfull_new_hiding",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Watchtower",
      "uninstallDisplayName": "Watchtower",
      "differentialPackage": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
